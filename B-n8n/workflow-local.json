    {
      "id": "a4180632-b6b8-5d29-843b-ac46ee29c061",
      "name": "Configuration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{json: {timestamp: new Date().toISOString(), fromEmail: 'configure@example.invalid', toEmail: 'configure@example.invalid', outputDir: '/home/node/.n8n-files'}}];"
      }
    },
    {
      "id": "879a4d5e-6401-5c6a-8983-1e77fed28c7b",
      "name": "Discover pagination",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "url": "https://webscraper.io/test-sites/e-commerce/static/computers/laptops",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "data"
            }
          },
          "timeout": 20000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "a9fb5cbf-49c9-5316-9da2-cbbfaac1763b",
      "name": "Build page list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "// All pagination links include the last page on this static test site.\nconst html = $input.first().json.data;\nif (typeof html !== 'string' || !html.includes('static-pagination')) {\n  throw new Error('Sayfalama alanı bulunamadı; site/HTML yapısı değişmiş olabilir.');\n}\nconst pages = [...html.matchAll(/href=[\"'][^\"']*\\/static\\/computers\\/laptops\\?page=(\\d+)[\"']/g)]\n  .map(match => Number(match[1]));\nconst lastPage = Math.max(1, ...pages);\nif (!Number.isInteger(lastPage) || lastPage > 200) throw new Error('Sayfa güvenlik sınırı aşıldı.');\nreturn Array.from({length: lastPage}, (_, i) => ({json: {\n  page: i + 1,\n  totalPages: lastPage,\n  url: `https://webscraper.io/test-sites/e-commerce/static/computers/laptops?page=${i + 1}`,\n}}));\n",
        "mode": "runOnceForAllItems"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "bbfb9198-c694-5214-876c-12f5baf11032",
      "name": "Fetch every page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "data"
            }
          },
          "timeout": 20000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 250
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "75710fa6-a6c2-5b4a-9da5-53a194ca89a0",
      "name": "Extract products",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "operation": "extractHtmlContent",
        "sourceData": "json",
        "dataPropertyName": "data",
        "extractionValues": {
          "values": [
            {
              "key": "names",
              "cssSelector": ".thumbnail a.title",
              "returnValue": "attribute",
              "attribute": "title",
              "returnArray": true
            },
            {
              "key": "prices",
              "cssSelector": ".thumbnail [itemprop=\"price\"]",
              "returnValue": "text",
              "returnArray": true
            },
            {
              "key": "reviews",
              "cssSelector": ".thumbnail [itemprop=\"reviewCount\"]",
              "returnValue": "text",
              "returnArray": true
            },
            {
              "key": "links",
              "cssSelector": ".thumbnail a.title",
              "returnValue": "attribute",
              "attribute": "href",
              "returnArray": true
            }
          ]
        },
        "options": {
          "trimValues": true,
          "cleanUpText": true
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "0417fafd-0377-5f1c-aa89-b581eeb63c0a",
      "name": "Compare snapshots",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "jsCode": "const pages = $input.all();\nconst planned = $('Build page list').all();\nif (!pages.length || pages.length !== planned.length) throw new Error('Eksik sayfa; kısmi sonuç kaydedilmeyecek.');\nconst timestamp = $('Configuration').first().json.timestamp;\nconst products = [];\nconst seen = new Set();\nfor (let pageIndex = 0; pageIndex < pages.length; pageIndex++) {\n  const page = pages[pageIndex].json;\n  const fields = ['names', 'prices', 'reviews', 'links'];\n  if (fields.some(key => !Array.isArray(page[key])) || !page.names.length ||\n      fields.some(key => page[key].length !== page.names.length)) {\n    throw new Error(`Sayfa ${pageIndex + 1}: boş ürün listesi veya eksik alan.`);\n  }\n  for (let i = 0; i < page.names.length; i++) {\n    const name = String(page.names[i]).trim();\n    const rawPrice = String(page.prices[i]).trim();\n    const rawReviews = String(page.reviews[i]).trim();\n    const href = String(page.links[i]);\n    if (!name || !/^\\$(?:\\d+|\\d{1,3}(?:,\\d{3})+)(?:\\.\\d{1,2})?$/.test(rawPrice) || !/^\\d+$/.test(rawReviews) ||\n        !/^\\/test-sites\\/e-commerce\\/static\\/product\\/\\d+$/.test(href)) {\n      throw new Error(`Sayfa ${pageIndex + 1}: ürün alanları doğrulanamadı.`);\n    }\n    const price = Number(rawPrice.replace(/[$,]/g, ''));\n    const reviews = Number(rawReviews);\n    const url = 'https://webscraper.io' + href;\n    if (!Number.isFinite(price) || price < 0 || !Number.isSafeInteger(reviews)) throw new Error('Geçersiz sayısal değer.');\n    if (seen.has(url)) throw new Error('Yinelenen ürün: sayfalama tutarsız; önceki durum korunacak.');\n    seen.add(url);\n    products.push({timestamp, name, price, reviews, url, currency: 'USD'});\n  }\n}\nconst state = $getWorkflowStaticData('global');\nconst previous = state.previous || {};\nconst snapshot = {};\nconst changes = [];\nfor (const product of products) {\n  const old = previous[product.url];\n  snapshot[product.url] = {price: product.price, name: product.name};\n  if (!old) changes.push({...product, change: 'new', oldPrice: null});\n  else if (Math.round(old.price * 100) !== Math.round(product.price * 100)) {\n    changes.push({...product, change: 'price_changed', oldPrice: old.price});\n  }\n}\nconst text = [`Laptop fiyat takibi — ${timestamp}`, `${pages.length} sayfa / ${products.length} ürün / ${changes.length} değişiklik`,\n  state.previous ? 'Önceki başarılı çalışmayla karşılaştırıldı.' : 'İlk çalışma: tüm ürünler yeni olarak bildiriliyor.', '',\n  ...changes.map(p => `${p.change === 'new' ? 'YENİ' : 'FİYAT'} | ${p.name} | ${p.oldPrice === null ? '—' : '$' + p.oldPrice.toFixed(2)} → $${p.price.toFixed(2)} | ${p.url}`)\n].join('\\n');\n// State is only committed AFTER file writing and any notification succeed.\nreturn [{json: {timestamp, products, snapshot, changes, hasChanges: changes.length > 0, text,\n  subject: `Laptop takip: ${changes.length} yeni/fiyatı değişen ürün`}}];\n",
        "mode": "runOnceForAllItems"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "549820b0-1cb7-5b16-a461-90712dd41c76",
      "name": "CSV rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "jsCode": "const run = $input.first().json;\n// Prevent spreadsheet formula evaluation in text cells; prices remain numbers.\nconst safeText = value => /^[=+@\\-\\t\\r\\n]/.test(value) ? \"'\" + value : value;\nreturn run.products.map(p => ({json: {...p, name: safeText(p.name)}}));\n",
        "mode": "runOnceForAllItems"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "d5cd0705-b8cc-529d-9a19-e7a380545325",
      "name": "Create CSV",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "operation": "csv",
        "binaryPropertyName": "data",
        "options": {
          "headerRow": true,
          "fileName": "laptops.csv"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "a9618ce8-9a28-513f-93ba-8d9c63db6671",
      "name": "Archive dated CSV",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        2160,
