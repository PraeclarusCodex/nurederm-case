    {
      "id": "10c67b7b-3fd2-5aa4-8649-603adf350538",
      "name": "Commit successful snapshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        0
      ],
      "parameters": {
        "jsCode": "const run = $('Compare snapshots').first().json;\nconst state = $getWorkflowStaticData('global');\nstate.previous = run.snapshot;\nstate.lastSuccessAt = run.timestamp;\nreturn [{json: {success: true, timestamp: run.timestamp, products: run.products.length,\n  changes: run.changes.length, note: 'Kalıcı durum yalnızca aktif zamanlanmış çalışmalarda saklanır.'}}];\n",
        "mode": "runOnceForAllItems"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "464290b7-6503-51d0-8c17-e35439186f01",
      "name": "Prepare failure alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        480
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const errors = $input.all().map(i => i.json.error?.message || i.json.error || i.json.message || 'Bilinmeyen hata'); return [{json:{subject:'HATA: Laptop fiyat takibi tamamlanamadı', text: 'Çalışma: ' + $execution.id + '\\nÖnceki başarılı durum korunuyor.\\n' + errors.map(String).join('\\n').slice(0, 3000)}}];"
      }
    },
    {
      "id": "b814a6b3-db15-5872-a7a2-f48c8d621a70",
      "name": "Notify failure",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1680,
        480
      ],
      "parameters": {
        "fromEmail": "={{ $('Configuration').first().json.fromEmail }}",
        "toEmail": "={{ $('Configuration').first().json.toEmail }}",
        "emailFormat": "text",
        "options": {
          "appendAttribution": false
        },
        "subject": "={{ $json.subject }}",
        "text": "={{ $json.text }}"
      }
    },
    {
      "id": "8c209cb4-700f-5b85-84e5-0827d619a6f7",
      "name": "Mark execution failed",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1920,
        480
      ],
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "Fiyat takibi başarısız; önceki başarılı durum güncellenmedi."
      }
    },
    {
      "id": "999ea208-7d59-57fa-a93b-02fdac58b754",
      "name": "Setup and provenance",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        430
      ],
      "parameters": {
        "content": "## FiyatRadar — günlük laptop takibi\nBaşlangıç şablonu: Track changes of product prices (#837)\nhttps://n8n.io/workflows/837-track-changes-of-product-prices/\n\n1. Configuration: e-posta adreslerini değiştir.\n2. Her iki Email düğümüne SMTP credential seç.\n3. CSV dizinini oluştur, kalıcı volume bağla ve yazma izni ver.\n4. Aktif/published akışı günde 09:00 Europe/Istanbul çalıştır.\n\nCSV: her çalışmada tüm ürünler + ISO tarih; karşılaştırma: son başarılı static data.\nManuel test static data saklamaz. İlk çalışmada tüm ürünler YENİ.\nHata çıkışları → bildirim → Stop And Error.\nCanlı SMTP ve n8n yürütme bu teslimde doğrulanmamıştır.",
        "height": 430,
        "width": 610
      }
    }
  ],
